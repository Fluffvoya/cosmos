<Window x:Class="app.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:app.Converters"
        xmlns:selectors="clr-namespace:app.Views.DataTemplateSelectors"
        Title="Cosmos" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:EqualityToVisibilityConverter x:Key="EqToVis"/>

        <!-- Settings tab content template -->
        <DataTemplate x:Key="SettingsTemplate">
            <DockPanel LastChildFill="True" Margin="16">
                <!-- Action buttons fixed at bottom-right -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="Apply"
                            Command="{Binding tag.applyCommand}"
                            Padding="16,6" Margin="0,0,8,0"/>
                    <Button Content="Save"
                            Command="{Binding tag.saveCommand}"
                            Padding="16,6" Margin="0,0,8,0"/>
                    <Button Content="Cancel"
                            Command="{Binding tag.cancelCommand}"
                            Padding="16,6"/>
                </StackPanel>

                <!-- Category sidebar + settings content -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Category sidebar -->
                    <ListBox Grid.Column="0"
                             ItemsSource="{Binding tag.settingsCategories}"
                             SelectedItem="{Binding tag.selectedCategory}"
                             Margin="0,0,16,0"
                             BorderThickness="0"/>

                    <!-- Settings content per category -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="400">

                            <!-- General category -->
                            <StackPanel Visibility="{Binding tag.selectedCategory,
                                Converter={StaticResource EqToVis}, ConverterParameter=General}">
                                <TextBlock Text="General" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

                                <TextBlock Text="Tab Position" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding tag.tabPositions}"
                                          SelectedItem="{Binding tag.tabPosition}"
                                          Width="200"/>
                            </StackPanel>

                            <!-- Scripting category -->
                            <StackPanel Visibility="{Binding tag.selectedCategory,
                                Converter={StaticResource EqToVis}, ConverterParameter=Scripting}">
                                <TextBlock Text="Scripting" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

                                <TextBlock Text="Python Path" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBox Text="{Binding tag.pythonPath, UpdateSourceTrigger=PropertyChanged}"
                                             Width="260" VerticalAlignment="Center"/>
                                    <Button Content="Browse..."
                                            Command="{Binding tag.browsePythonPathCommand}"
                                            Margin="8,0,0,0" Padding="12,4"/>
                                </StackPanel>
                                <TextBlock Foreground="Red" FontSize="11" Margin="0,0,0,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value=""/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding tag.isValidPythonPath}" Value="False">
                                                    <Setter Property="Text" Value="File does not exist."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </DataTemplate>

        <!-- Default document tab content template -->
        <DataTemplate x:Key="DocumentTemplate">
            <Grid>
                <TextBlock Text="{Binding contentType}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16"
                           Foreground="Gray"/>
            </Grid>
        </DataTemplate>

        <!-- Template selector that picks the right template per tab -->
        <selectors:TabContentTemplateSelector x:Key="TabSelector"
                                               SettingsTemplate="{StaticResource SettingsTemplate}"
                                               DocumentTemplate="{StaticResource DocumentTemplate}"/>
    </Window.Resources>

    <DockPanel>
        <!-- ── Top Menu Bar ──────────────────────────────────────── -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Settings" Command="{Binding openSettingsCommand}"/>
            <MenuItem Header="Help">
                <MenuItem Header="About" Command="{Binding aboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- ── Main Content: TabControl ──────────────────────────── -->
        <TabControl ItemsSource="{Binding tabs}"
                    SelectedItem="{Binding selectedTab}"
                    TabStripPlacement="{Binding tabStripPlacement}"
                    AllowDrop="True"
                    DragOver="OnTabControlDragOver"
                    DragLeave="OnTabControlDragLeave"
                    Drop="OnTabControlDrop">

            <!-- Style for each TabItem -->
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Icon (optional) -->
                                    <TextBlock Text="{Binding icon}"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="14"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding icon, Converter={StaticResource BoolToVis}}"/>

                                    <!-- Title -->
                                    <TextBlock Text="{Binding title}" VerticalAlignment="Center"/>

                                    <!-- Close button -->
                                    <Button Content="✕"
                                            Margin="8,0,0,0"
                                            Padding="2,0"
                                            FontSize="10"
                                            Command="{Binding DataContext.closeTabCommand,
                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Foreground" Value="Gray"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="Red"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- Use the template selector for tab content -->
            <TabControl.ContentTemplateSelector>
                <selectors:TabContentTemplateSelector SettingsTemplate="{StaticResource SettingsTemplate}"
                                                      DocumentTemplate="{StaticResource DocumentTemplate}"/>
            </TabControl.ContentTemplateSelector>
        </TabControl>
    </DockPanel>
</Window>
