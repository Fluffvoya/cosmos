<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>cosmos</AssemblyName>
    <RootNamespace>app</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Suppress MSB3277: WebView2 NuGet package forces both WinForms and WPF assemblies
         for all .NET 5+ projects. The WPF DLL references WindowsBase 5.0.0.0 which conflicts
         with .NET SDK's WindowsBase 4.0.0.0. This is harmless �?only WinForms is used at runtime.
         The package does not offer a way to exclude WPF assemblies. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\app-bridge\app-bridge.csproj" />
    <ProjectReference Include="..\app-password\app-password.csproj" />
    <ProjectReference Include="..\app-settings\app-settings.csproj" />
    <ProjectReference Include="..\app-scheduler\app-scheduler.csproj" />
    <ProjectReference Include="..\app-script\app-script.csproj" />
    <ProjectReference Include="..\app-launcher\app-launcher.csproj" />
    <ProjectReference Include="..\bridge\bridge.csproj" />
    <ProjectReference Include="..\cm-script\cm-script.csproj" />
    <ProjectReference Include="..\server\server.csproj" />
    <ProjectReference Include="..\script-func\script-func.csproj" />
    <ProjectReference Include="..\error\error.csproj" />
    <ProjectReference Include="..\public-model\public-model.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
