<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Update="scripts\**\*.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\error\error.csproj" />
    <ProjectReference Include="..\argument\argument.csproj" />
    <ProjectReference Include="..\func-router\func-router.csproj" />
    <ProjectReference Include="..\cm-script\cm-script.csproj" />
    <ProjectReference Include="..\client\client.csproj" />
    <ProjectReference Include="..\public-model\public-model.csproj" />
    <ProjectReference Include="..\server\server.csproj" />
    <ProjectReference Include="..\process\process.csproj" />
  </ItemGroup>

</Project>